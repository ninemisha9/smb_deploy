# .env
IP=<ip-адрес хоста, на котором нужно развернуть общую папку>
SMB_IP=<ip-адрес сервера>
PASSWORD=<пароль от хоста, на котором нужно развернуть общую папку>
LOGIN=<пользователь хоста, на котором нужно равзернуть общую папку>
DIR_NAME=<директория на хосте, в которую будет подгружаться общая папка>
SMBCREDS_FILE=<имя файла с кредами на хосте>
SMB_LOGIN=<логин из кредов>
SMB_PASSWORD=<пароль из кредов>